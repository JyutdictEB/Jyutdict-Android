<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/whole_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        app:title="@string/app_name"
        app:titleTextColor="@color/colorWhite" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/search_panel"
            android:layout_width="380dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/query_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/clockBackground"
                android:elevation="3dp"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:id="@+id/input_line"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edit_text_input"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:backgroundTint="@color/colorPrimary"
                            android:ems="10"
                            android:hint="@string/search_tips"
                            android:imeActionLabel="@string/search_button"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="36dp"
                            android:paddingVertical="0dp"
                            android:singleLine="true"
                            android:textColor="?attr/clockTextColor"
                            android:textColorHint="?attr/clockTextColorDim"
                            android:textSize="16sp"
                            android:theme="@style/MyEditText" />

                        <TextView
                            android:id="@+id/btn_clear_input"
                            android:layout_width="36dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/search_clear_description"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/search_clear"
                            android:textColor="?attr/clockTextColorDim"
                            android:textSize="18sp"
                            android:visibility="gone" />

                    </FrameLayout>

                    <Button
                        android:id="@+id/btn_query"
                        android:layout_width="56dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_solid_accent_button"
                        android:foreground="?selectableItemBackground"
                        android:text="@string/search_button"
                        android:textColor="@color/btn_solid_accent_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/input_switch"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioGroup
                        android:id="@+id/sheet_mode_group"
                        android:layout_width="196dp"
                        android:layout_height="match_parent"
                        android:checkedButton="@id/btn_common_sheet"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/btn_common_sheet"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:buttonTint="@color/btn_mode_radio_tint"
                            android:gravity="center_vertical"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="2dp"
                            android:singleLine="true"
                            android:text="@string/search_common_sheet"
                            android:textAllCaps="false"
                            android:textColor="@color/btn_mode_radio_tint"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/btn_jyut_sheet"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:buttonTint="@color/btn_mode_radio_tint"
                            android:gravity="center_vertical"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:singleLine="true"
                            android:text="@string/search_jyut_sheet"
                            android:textAllCaps="false"
                            android:textColor="@color/btn_mode_radio_tint"
                            android:textSize="12sp" />

                    </RadioGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/switch_reverse_search"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:checkable="true"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/search_reversal"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_toggle_chip_text"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:backgroundTint="@color/btn_toggle_chip_bg"
                        app:cornerRadius="0dp"
                        app:elevation="0dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sheet_query_options"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="false"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/locate_picker"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="6dp">

                        <View
                            android:id="@+id/locate_picker_swatch"
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/locate_picker_text"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:textColor="?attr/clockTextColor"
                            android:textSize="13sp"
                            tools:ignore="NestedWeights" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/search_choose_location"
                            android:src="@drawable/ic_arrow_drop_down_24"
                            app:tint="?attr/clockTextColorDim" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/input_advanced_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/switch_use_regex"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:checkable="true"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="@string/search_enable_regex"
                            android:textAllCaps="false"
                            android:textColor="@color/btn_toggle_chip_text"
                            android:textSize="12sp"
                            app:backgroundTint="@color/btn_toggle_chip_bg"
                            app:cornerRadius="0dp"
                            app:elevation="0dp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_filter_area"
                        style="@style/ButtonTextColor"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#00000000"
                        android:foreground="?selectableItemBackground"
                        android:text="@string/search_filtering_area"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_filter_area_pron"
                        style="@style/ButtonTextColor"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#00000000"
                        android:foreground="?selectableItemBackground"
                        android:text="@string/search_filtering_area_pron"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_coloring_jpp_partial"
                        style="@style/ButtonTextColor"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#00000000"
                        android:foreground="?selectableItemBackground"
                        android:text="@string/search_coloring_jpp_partial"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/search_panel"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/header_loading_status"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="?attr/clockBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/header_loading_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/clockTextColorDim" />

                <TextView
                    android:id="@+id/header_loading_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/clockTextColorDim"
                    android:textSize="12sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/loading_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/result_fragment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/clockBackground" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
