<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reader_state_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Jyutdict.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/reader_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceContainerHighest"
        app:trackThickness="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface">

        <WebView
            android:id="@+id/reader_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_error"
            style="@style/Widget.Jyutdict.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
