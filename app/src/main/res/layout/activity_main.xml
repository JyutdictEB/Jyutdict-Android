<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/whole_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tool_bar"
        style="@style/Widget.Jyutdict.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        app:title="@string/app_name" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/query_layout"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_xs"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/input_line"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Jyutdict.SearchField"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    app:endIconContentDescription="@string/search_clear"
                    app:endIconMode="clear_text"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/search_tips"
                        android:imeActionLabel="@string/search_button"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="4dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_query"
                    style="@style/Widget.Jyutdict.ActionButton"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="0dp"
                    android:text="@string/search_button"
                    android:textColor="?attr/colorPrimary"
                    app:backgroundTint="?attr/colorPrimaryContainer"
                    app:cornerRadius="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/input_switch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/compact_touch_target"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/search_options_title"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <cc.ecisr.jyutdict.widget.SwitchCustomized
                    android:id="@+id/switch_select_sheet"
                    style="@style/Widget.Jyutdict.Switch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/search_common_sheet"
                    android:textColor="?attr/colorOnSurface" />

                <cc.ecisr.jyutdict.widget.SwitchCustomized
                    android:id="@+id/switch_reverse_search"
                    style="@style/Widget.Jyutdict.Switch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/search_reversal"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <Spinner
                android:id="@+id/locate_spinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/compact_touch_target"
                android:layout_marginTop="2dp"
                android:dropDownVerticalOffset="4dp"
                android:popupBackground="?attr/colorSurfaceContainerHigh"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_area"
                    style="@style/Widget.Jyutdict.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/compact_touch_target"
                    android:layout_weight="1"
                    android:text="@string/search_filtering_area" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_area_pron"
                    style="@style/Widget.Jyutdict.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/compact_touch_target"
                    android:layout_weight="1"
                    android:text="@string/search_filtering_area_pron"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_coloring_jpp_partial"
                    style="@style/Widget.Jyutdict.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/compact_touch_target"
                    android:layout_weight="1"
                    android:text="@string/search_coloring_jpp_partial" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/input_advanced_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <cc.ecisr.jyutdict.widget.SwitchCustomized
                    android:id="@+id/switch_use_regex"
                    style="@style/Widget.Jyutdict.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_enable_regex"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/header_loading_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_horizontal_padding"
        android:paddingEnd="@dimen/content_horizontal_padding"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/header_loading_spinner"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="16dp"
            app:trackThickness="2dp" />

        <TextView
            android:id="@+id/header_loading_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loading_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceContainerHighest"
        app:trackThickness="4dp" />

    <FrameLayout
        android:id="@+id/result_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface" />

</LinearLayout>
