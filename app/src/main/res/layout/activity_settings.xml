<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        app:title="@string/title_activity_settings"
        app:titleTextColor="@color/colorWhite" />

    <FrameLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/clockBackground"
        android:elevation="2dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_check_version"
            style="@style/ButtonTextColor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#00000000"
            android:foreground="?selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="@string/app_version"
            android:textColor="?attr/clockTextColor"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="?attr/clockHover" />

        <Button
            android:id="@+id/btn_about"
            style="@style/ButtonTextColor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#00000000"
            android:foreground="?selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="@string/app_about"
            android:textAllCaps="false"
            android:textColor="?attr/clockTextColorDim"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
