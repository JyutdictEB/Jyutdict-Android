<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comment_state_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/clockBackground"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <ProgressBar
        android:id="@+id/comment_loading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="20dp"
        android:indeterminateTint="@color/colorPrimary" />

    <TextView
        android:id="@+id/comment_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="20dp"
        android:text="@string/comment_empty"
        android:textColor="?attr/clockTextColorDim"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/comment_list"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/comment_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/colorPrimary"
        android:gravity="top|start"
        android:hint="@string/comment_input_hint"
        android:maxLength="5000"
        android:maxLines="4"
        android:minLines="2"
        android:padding="8dp"
        android:textColor="?attr/clockTextColor"
        android:textColorHint="?attr/clockTextColorDim"
        android:textSize="14sp"
        android:theme="@style/MyEditText" />

    <Button
        android:id="@+id/comment_submit"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_solid_accent_button"
        android:foreground="?selectableItemBackground"
        android:text="@string/comment_submit"
        android:textColor="@color/btn_solid_accent_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
