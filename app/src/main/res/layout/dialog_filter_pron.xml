<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/filter_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="@color/colorPrimary"
        android:hint="@string/search_filter_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="?attr/clockTextColor"
        android:textColorHint="?attr/clockTextColorDim"
        android:textSize="14sp"
        android:theme="@style/MyEditText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filter_selection_summary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="?attr/clockTextColorDim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_dialog_select_all"
            style="@style/ButtonTextColor"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="#00000000"
            android:foreground="?selectableItemBackground"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/button_all_check"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_dialog_invert"
            style="@style/ButtonTextColor"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="#00000000"
            android:foreground="?selectableItemBackground"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/button_none_check"
            android:textSize="12sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/checkbox_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />

    </ScrollView>

</LinearLayout>
