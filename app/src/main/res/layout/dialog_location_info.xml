<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/location_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_location_dialog"
    android:minHeight="224dp"
    android:minWidth="300dp"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/location_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/clockTextColor"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/location_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/location_close"
            android:padding="10dp"
            android:src="@drawable/ic_close_20"
            app:tint="?attr/clockTextColor" />

    </LinearLayout>

    <TextView
        android:id="@+id/location_redirect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="16dp"
        android:paddingStart="8dp"
        android:textColor="?attr/clockTextColorDim"
        android:textSize="12sp"
        android:visibility="invisible"
        tools:ignore="RtlSymmetry" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/location_metadata_accent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary" />

        <TextView
            android:id="@+id/location_metadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="98dp"
            android:padding="11dp"
            android:textColor="?attr/clockTextColor"
            android:textIsSelectable="true"
            android:textSize="13sp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/location_article_checking"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/location_article"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_solid_accent_button"
            android:enabled="false"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/location_article_checking"
            android:textAllCaps="false"
            android:textColor="@color/btn_solid_accent_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/location_phonology"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_solid_accent_button"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/location_phonology"
            android:textAllCaps="false"
            android:textColor="@color/btn_solid_accent_text"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
