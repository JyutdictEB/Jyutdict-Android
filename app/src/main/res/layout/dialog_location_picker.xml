<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/location_picker_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="@color/colorPrimary"
        android:hint="@string/search_filter_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="?attr/clockTextColor"
        android:textColorHint="?attr/clockTextColorDim"
        android:textSize="14sp"
        android:theme="@style/MyEditText" />

    <TextView
        android:id="@+id/location_picker_summary"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:textColor="?attr/clockTextColorDim"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/location_picker_recent"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp"
        android:background="?attr/clockHover"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <View
            android:id="@+id/location_picker_recent_swatch"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/location_picker_recent_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="?attr/clockTextColor"
            android:textSize="13sp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/location_picker_scroll"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:fadeScrollbars="false"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/location_picker_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />

    </ScrollView>

</LinearLayout>
