<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/clockBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/version_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/clockTextColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/version_check_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/version_status_not_checked"
            android:textColor="?attr/clockTextColor"
            android:textSize="13sp" />

        <Button
            android:id="@+id/version_check_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_solid_accent_button"
            android:foreground="?selectableItemBackground"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="@string/version_check_action"
            android:textColor="@color/btn_solid_accent_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/clockHover" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_download_title"
            android:textColor="?attr/clockTextColorDim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/version_download_baidu"
            style="@style/ButtonTextColor"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#00000000"
            android:foreground="?selectableItemBackground"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="4dp"
            android:text="@string/version_download_baidu"
            android:textColor="?attr/clockTextColor"
            android:textSize="13sp" />

        <Button
            android:id="@+id/version_download_tianyi"
            style="@style/ButtonTextColor"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#00000000"
            android:foreground="?selectableItemBackground"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="4dp"
            android:text="@string/version_download_tianyi"
            android:textColor="?attr/clockTextColor"
            android:textSize="13sp" />

        <Button
            android:id="@+id/version_download_github"
            style="@style/ButtonTextColor"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#00000000"
            android:foreground="?selectableItemBackground"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="4dp"
            android:text="@string/version_download_github"
            android:textColor="?attr/clockTextColor"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
