<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_item"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_sm"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="@dimen/space_sm"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/item_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/item_chara"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_character_block"
                android:gravity="center"
                android:minHeight="88dp"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/chara_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/result_list_chara"
                    android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                    android:textSize="34sp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/chara_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/result_list_info"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/chara_extra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/result_list_extra"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnPrimaryContainer" />

            </LinearLayout>

            <cc.ecisr.jyutdict.widget.SelectableTextView
                android:id="@+id/content_wanshyu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:text="@string/result_list_upper"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

        <View
            android:id="@+id/content_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="?attr/colorOutlineVariant" />

        <cc.ecisr.jyutdict.widget.SelectableTextView
            android:id="@+id/content_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingTop="6dp"
            android:lineSpacingExtra="1dp"
            android:text="@string/result_list_bottom"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
