<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="2dp"
    android:background="?attr/clockBackground"
    android:elevation="2dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/item_chara"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="72dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/chara_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/result_list_chara"
                android:textColor="?attr/clockTextColor"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/chara_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/result_list_info"
                android:textColor="?attr/clockTextColorDim"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chara_extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="70dp"
                android:gravity="center"
                android:text="@string/result_list_extra"
                android:textColor="?attr/clockTextColorDim"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <cc.ecisr.jyutdict.widget.SelectableTextView
                android:id="@+id/content_wanshyu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:text="@string/result_list_upper"
                android:textColor="?attr/clockTextColor"
                android:textSize="13sp" />

            <View
                android:id="@+id/content_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="@color/colorHover" />

            <cc.ecisr.jyutdict.widget.SelectableTextView
                android:id="@+id/content_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:text="@string/result_list_bottom"
                android:textColor="?attr/clockTextColor"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheet_annotation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/colorHover"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/result_sheet_annotation_title"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp" />

        <cc.ecisr.jyutdict.widget.SelectableTextView
            android:id="@+id/sheet_annotation_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:textColor="?attr/clockTextColor"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
